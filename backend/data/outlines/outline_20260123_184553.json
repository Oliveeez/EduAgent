      {
        "title": "5. 实战：鸡兔同笼问题建模",
        "detail_level": "精讲",
        "points": [
          {
            "title": "问题重述",
            "content": "《孙子算经》经典问题：35头，94足，求雉兔几何？",
            "examples": [
              "雉(c) + 兔(r) = 35",
              "2*c + 4*r = 94"
            ],
            "key_concepts": [
              "Problem Statement",
              "Constraints"
            ]
          },
          {
            "title": "Coq形式化建模",
            "content": "定义一个定理，陈述存在满足条件的雉和兔的数量。",
            "examples": [
              "Definition heads (c r : nat) := c + r",
              "Definition feet (c r : nat) := 2*c + 4*r"
            ],
            "key_concepts": [
              "Modeling",
              "Definitions"
            ]
          },
          {
            "title": "验证解的正确性",
            "content": "验证 雉=23, 兔=12 是否满足上述定义。",
            "examples": [
              "Goal heads 23 12 = 35 /\\ feet 23 12 = 94."
            ],
            "key_concepts": [
              "Goal",
              "Conjunction (/\\)"
            ]
          }
        ]
      },
